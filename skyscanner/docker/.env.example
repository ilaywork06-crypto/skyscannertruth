# Copy this file to .env beside docker-compose.yml and change what you need. Everything has a default, so an
# empty .env - or none at all - runs the whole system on the containers the compose file starts.

# ---------------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------------
# Leave MONGO_URI unset to use the bundled MongoDB container. Set it to use your own server instead: the
# services connect there and the bundled container is not started. Credentials, TLS and the replica set go in
# the URI exactly as MongoDB documents them, and are never written to the logs.
#
#   MONGO_URI=mongodb://skyscanner:secret@db.example.com:27017/?authSource=admin
#   MONGO_URI=mongodb+srv://skyscanner:secret@cluster0.example.mongodb.net/?retryWrites=true&w=majority
#
# A MongoDB running on this machine itself is reached as host.docker.internal rather than as localhost:
#
#   MONGO_URI=mongodb://host.docker.internal:27017
#MONGO_URI=

# The database inside that server. The same name keeps the same data.
MONGO_DATABASE=skyscanner

# ---------------------------------------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------------------------------------
#S3_BUCKET=skyscanner-artifacts
#S3_ACCESS_KEY_ID=skyscanner
#S3_SECRET_ACCESS_KEY=skyscanner-secret
# The address a browser reaches the bucket at, for temporary download links. Empty = stream through the service.
#S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Set to false only for a bucket behind a self-signed certificate you cannot install.
#S3_VERIFY_TLS=true

# ---------------------------------------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------------------------------------
# WARNING: out of the box a caller without identity headers is treated as an administrator, exactly as before.
# Behind the authenticating proxy, turn that off:
#AUTH_ALLOW_ANONYMOUS=false
#AUTH_ANONYMOUS_ROLES=viewer

# ---------------------------------------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------------------------------------
#SMTP_HOST=mailhog
#SMTP_PORT=1025
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_USE_TLS=false
#MAIL_FROM=skyscanner@example.com
