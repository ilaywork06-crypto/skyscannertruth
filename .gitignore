# Dependencies. Every machine installs its own from the lockfile, which is what is committed instead.
node_modules/

# Build output. Rebuilt from source on demand, and committing it means every build shows up as a diff.
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/
.eslintcache

# Python environments, caches and packaging leftovers.
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.dmypy.json
*.egg-info/
.eggs/

# Test and coverage output.
coverage/
htmlcov/
.coverage
.coverage.*
test-results/
playwright-report/

# Local configuration, which is per machine and often holds secrets.
.env
.env.*
!.env.example

# Editor, assistant and operating system leavings.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.claude/settings.local.json

# Logs.
*.log
npm-debug.log*
