# The served client, with the API address filled in when the container starts (envsubst, TRUTH_API_URL only).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # The trailing slash on TRUTH_API_URL strips the /api the client prefixes: /api/assumption -> /assumption.
    location /api/ {
        proxy_pass ${TRUTH_API_URL};
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Every address of the client is served by the one page; its routes live in the browser.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
